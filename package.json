{
  "name": "@nswds/eslint-config",
  "version": "1.1.1",
  "description": "Shared ESLint flat config for the NSW Design System fleet — Next.js ('.') and framework-free ('./base') entry points, both with Prettier as a rule.",
  "license": "MPL-2.0",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "nextjs",
    "prettier",
    "nswds",
    "nsw-government"
  ],
  "homepage": "https://github.com/digitalnsw/nswds-eslint-config#readme",
  "bugs": {
    "url": "https://github.com/digitalnsw/nswds-eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/digitalnsw/nswds-eslint-config.git"
  },
  "author": "NSW Design System",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./base": "./base.mjs"
  },
  "files": [
    "index.mjs",
    "base.mjs",
    "shared.mjs"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "semantic-release": "semantic-release",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "prepare": "husky",
    "branch:create": "scripts/create-branch.sh",
    "branch:suggest": "scripts/suggest-branch-name.sh",
    "branch:suggest:create": "scripts/suggest-branch-name.sh --create",
    "commit": "scripts/git-commit.sh",
    "pr": "scripts/pull-request.sh",
    "snyk:check": "bash -lc 'npm exec --yes --package snyk@latest -- snyk test --all-projects --json-file-output=snyk-analysis.json; code=$?; if [ $code -eq 0 ] || [ $code -eq 1 ]; then exit 0; fi; exit $code'",
    "snyk:monitor": "npm exec --yes --package snyk@latest -- snyk monitor --all-projects",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@eslint/compat": ">=2",
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-next": ">=15",
    "eslint-config-prettier": ">=10",
    "eslint-plugin-prettier": ">=5",
    "typescript-eslint": ">=8.28"
  },
  "peerDependenciesMeta": {
    "@eslint/compat": {
      "optional": false
    },
    "@eslint/js": {
      "optional": true
    },
    "eslint-config-next": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "globals": "^17.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@nswds/prettier-config": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "next": "^16.2.11",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": "@nswds/prettier-config"
}
